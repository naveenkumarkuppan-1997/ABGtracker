# Copy to .env and fill in. Used by docker-compose, or export these before `npm start`.

# --- required in production ---------------------------------------------------------
# The public address people use. Used in invitation and password-reset emails. Must be https.
PUBLIC_URL=https://tracker.example.com

# --- legacy PostgreSQL (optional during Firebase migration) -------------------------
# When DATABASE_URL is not set, the server runs with embedded database (PGlite).
# Set DATABASE_URL only if connecting to an external PostgreSQL database.
# DATABASE_URL=postgres://abg:change-me@localhost:5432/abg
# POSTGRES_PASSWORD is only used by docker-compose.yml to launch a local postgres container
# POSTGRES_PASSWORD=change-me

# --- recommended ---------------------------------------------------------------------
# Email delivery (invitations, password reset). Without it emails are only printed in the server log.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=ABG Tracker <no-reply@example.com>
# Set to true ONLY when a reverse proxy you control sits in front (so client addresses are read correctly).
TRUST_PROXY=true
# false = only invited people can join; nobody can create a new organization.
ALLOW_SIGNUP=true

# --- optional ---------------------------------------------------------------------------
# Notification emails need SMTP_URL above. "Once a day" summaries go out at this hour of each person's own day (0-23, in the time zone they chose).
# DIGEST_HOUR=8

# File attachments. Uploaded files live in FILES_DIR (back it up together with the database).
# FILES_DIR=./server-files
# MAX_FILE_MB=25
# ORG_STORAGE_MB=1024
# MAX_FILES_PER_ISSUE=25
# Extensions refused for upload (default blocks programs and scripts such as exe, bat, js, sh). Set empty to allow all.
# BLOCKED_EXTENSIONS=exe,msi,bat,cmd,com,scr,ps1,vbs,js,jar,dll,sh
# Memory control: organizations kept in memory at once, and minutes before an idle one is dropped.
# ORG_CACHE_MAX=50
# ORG_CACHE_IDLE_MINUTES=30
# PORT=4000
# HOST=0.0.0.0
# LOG_LEVEL=info
# Single-machine trial without PostgreSQL (embedded database in DATA_DIR). Not for real use.
# ALLOW_EMBEDDED_DB=1
# DATA_DIR=./server-data

# --- Firebase Phase 1 Configuration ----------------------------------------------------
# Frontend Client Configuration (Vite public variables, no secrets)
VITE_FIREBASE_API_KEY="AIzaSyYourProjectApiKeyPlaceholder"
VITE_FIREBASE_AUTH_DOMAIN="abg-tracker-v2.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="abg-tracker-v2"
VITE_FIREBASE_STORAGE_BUCKET="abg-tracker-v2.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"
# Optional: Point client to local Firebase Auth Emulator (e.g. for offline dev)
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099

# Backend Firebase Admin Configuration (Server-side only)
FIREBASE_PROJECT_ID="abg-tracker-v2"
# Path to GCP service account JSON key file (do not expose in frontend)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Optional: Point backend to local Firebase Auth Emulator
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# --- MongoDB Atlas Integration (Server-only) --------------------------------------------
# Standard MongoDB connection string from MongoDB Atlas:
# Format: mongodb+srv://<username>:<password>@<cluster-host>/<database-name>?retryWrites=true&w=majority
# Security notice: Keep this strictly server-side. Do NOT use VITE_ prefix or commit credentials.
# MONGODB_URI=mongodb+srv://naveenkumarkuppan_db_user:<db_password>@abgtracker.lmjxmzf.mongodb.net/abg_tracker?retryWrites=true&w=majority

