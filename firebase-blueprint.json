{
  "entities": {
    "Organization": {
      "title": "Organization",
      "description": "Tenant organization boundary representing an enterprise workspace.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 50 },
        "plan": { "type": "string", "enum": ["free", "team", "business"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "slug", "plan", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "Public user profile and identity document.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "color"]
    },
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Isolated private settings, notification preferences and dashboard layout.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 128 },
        "notify": {
          "type": "object",
          "properties": {
            "email": { "type": "string", "enum": ["instant", "daily", "off"] },
            "scope": { "type": "string", "enum": ["important", "all"] },
            "timeZone": { "type": "string", "maxLength": 64 },
            "dueLeadDays": { "type": "number" }
          }
        },
        "dashboard": { "type": "object" }
      },
      "required": ["userId"]
    },
    "Membership": {
      "title": "Membership",
      "description": "Role-based access control link binding a user to an organization.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "orgId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "userId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 128 },
        "role": { "type": "string", "enum": ["owner", "admin", "member", "guest"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orgId", "userId", "role"]
    },
    "Project": {
      "title": "Project",
      "description": "Work container with custom statuses, issue types, workflow rules and custom fields.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "orgId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "key": { "type": "string", "pattern": "^[A-Z0-9]{2,10}$", "maxLength": 10 },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 2000 },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "workStyle": { "type": "string", "enum": ["agile", "flow", "business"] },
        "leadId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 128 },
        "nextNumber": { "type": "number" },
        "statuses": { "type": "array" },
        "issueTypes": { "type": "array" },
        "workflow": { "type": "object" },
        "customFields": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orgId", "key", "name", "workStyle", "leadId", "nextNumber"]
    },
    "Issue": {
      "title": "Issue",
      "description": "Work item trackable on Kanban boards, backlogs, lists and timelines.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "orgId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "projectId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "key": { "type": "string", "pattern": "^[A-Z0-9]+-[0-9]+$", "maxLength": 20 },
        "number": { "type": "number" },
        "typeId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "description": { "type": "string", "maxLength": 20000 },
        "statusId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "priority": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
        "assigneeId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 128 },
        "reporterId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 128 },
        "parentId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "labels": { "type": "array" },
        "estimate": { "type": "number" },
        "startDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "dueDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "sprintId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "blockedBy": { "type": "array" },
        "watcherIds": { "type": "array" },
        "rank": { "type": "number" },
        "approval": { "type": "object" },
        "source": { "type": "object" },
        "customFields": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "resolvedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orgId", "projectId", "key", "number", "typeId", "title", "statusId", "priority", "reporterId", "rank", "createdAt", "updatedAt"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Discussion comment on an issue with mentions and reactions.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "orgId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "projectId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "issueId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "authorId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 128 },
        "body": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "mentions": { "type": "array" },
        "reactions": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orgId", "projectId", "issueId", "authorId", "body", "createdAt"]
    },
    "Attachment": {
      "title": "Attachment",
      "description": "Metadata for files stored in Cloud Storage for Firebase.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "orgId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "projectId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "issueId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "commentId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "externalName": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "size": { "type": "number" },
        "mime": { "type": "string", "maxLength": 100 },
        "uploaderId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 128 },
        "storageKey": { "type": "string", "maxLength": 500 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orgId", "projectId", "issueId", "name", "size", "mime", "uploaderId", "storageKey", "sha256", "createdAt"]
    },
    "Sprint": {
      "title": "Sprint",
      "description": "Scrum iteration containing time-boxed work items.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "orgId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "projectId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "goal": { "type": "string", "maxLength": 500 },
        "state": { "type": "string", "enum": ["planned", "active", "completed"] },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" },
        "committedPoints": { "type": "number" },
        "completedPoints": { "type": "number" },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orgId", "projectId", "name", "state", "createdAt"]
    },
    "IntakeForm": {
      "title": "IntakeForm",
      "description": "External request intake form definitions for public issue creation.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "orgId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "projectId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 50 },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1000 },
        "enabled": { "type": "boolean" },
        "fields": { "type": "array" },
        "issueTypeId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "defaultPriority": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
        "defaultAssigneeId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 128 },
        "createdBy": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 128 },
        "submissionCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orgId", "projectId", "slug", "name", "enabled", "fields", "issueTypeId", "defaultPriority", "createdBy", "submissionCount", "createdAt"]
    },
    "AutomationRule": {
      "title": "AutomationRule",
      "description": "Workflow automation triggers, conditions, and actions.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "orgId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "projectId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "enabled": { "type": "boolean" },
        "trigger": { "type": "object" },
        "conditions": { "type": "array" },
        "actions": { "type": "array" },
        "createdBy": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 128 },
        "runCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orgId", "projectId", "name", "enabled", "trigger", "conditions", "actions", "createdBy", "runCount", "createdAt"]
    },
    "AutomationRun": {
      "title": "AutomationRun",
      "description": "Execution record log of an automation rule run.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "orgId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "projectId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "ruleId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "ruleName": { "type": "string", "maxLength": 100 },
        "issueId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "issueKey": { "type": "string", "maxLength": 20 },
        "result": { "type": "string", "enum": ["success", "skipped", "error"] },
        "message": { "type": "string", "maxLength": 500 },
        "at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orgId", "projectId", "ruleId", "ruleName", "issueId", "issueKey", "result", "at"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Inbox item notification targeted at an individual recipient.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "orgId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "userId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 128 },
        "actorId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 128 },
        "issueId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "projectId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "kind": { "type": "string", "enum": ["assigned", "mention", "comment", "status", "approval", "automation", "intake", "due"] },
        "detail": { "type": "string", "maxLength": 500 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orgId", "userId", "actorId", "issueId", "projectId", "kind", "read", "createdAt"]
    },
    "SavedFilter": {
      "title": "SavedFilter",
      "description": "Saved search filter owned by a user or shared with organization.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "orgId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "ownerId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "query": { "type": "string", "maxLength": 1000 },
        "shared": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orgId", "ownerId", "name", "query", "shared", "createdAt"]
    },
    "Activity": {
      "title": "Activity",
      "description": "Audit event and changelog entry on project work items.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "orgId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "projectId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "issueId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "actorId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 128 },
        "kind": { "type": "string", "enum": ["created", "updated", "commented", "deleted"] },
        "field": { "type": "string", "maxLength": 50 },
        "from": { "type": "string", "maxLength": 500 },
        "to": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orgId", "projectId", "issueId", "actorId", "kind", "createdAt"]
    },
    "Invite": {
      "title": "Invite",
      "description": "Pending invitation to join an organization.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "orgId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "role": { "type": "string", "enum": ["owner", "admin", "member", "guest"] },
        "invitedBy": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 128 },
        "tokenHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "acceptedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orgId", "email", "role", "invitedBy", "tokenHash", "createdAt", "expiresAt"]
    },
    "Webhook": {
      "title": "Webhook",
      "description": "Outbound webhook endpoint configuration for event delivery.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "orgId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "url": { "type": "string", "maxLength": 1000 },
        "secret": { "type": "string", "maxLength": 128 },
        "format": { "type": "string", "enum": ["json", "slack"] },
        "events": { "type": "string", "maxLength": 500 },
        "active": { "type": "boolean" },
        "createdBy": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastStatus": { "type": "string", "maxLength": 50 },
        "lastAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orgId", "url", "secret", "format", "events", "active", "createdBy", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Compliance audit log of organizational security and administrative actions.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "orgId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64 },
        "actorId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 50 },
        "detail": { "type": "string", "maxLength": 500 },
        "at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orgId", "actorId", "action", "detail", "at"]
    }
  },
  "firestore": {
    "/organizations/{orgId}": {
      "schema": "Organization",
      "description": "Primary tenant root organization document."
    },
    "/organizations/{orgId}/memberships/{membershipId}": {
      "schema": "Membership",
      "description": "Organization membership and role assignment subcollection."
    },
    "/organizations/{orgId}/projects/{projectId}": {
      "schema": "Project",
      "description": "Project workspace configuration, statuses, and workflow."
    },
    "/organizations/{orgId}/projects/{projectId}/issues/{issueId}": {
      "schema": "Issue",
      "description": "Project work items and tasks."
    },
    "/organizations/{orgId}/projects/{projectId}/issues/{issueId}/comments/{commentId}": {
      "schema": "Comment",
      "description": "Issue discussion comments and reactions."
    },
    "/organizations/{orgId}/projects/{projectId}/issues/{issueId}/attachments/{attachmentId}": {
      "schema": "Attachment",
      "description": "File attachment metadata records linked to Cloud Storage."
    },
    "/organizations/{orgId}/projects/{projectId}/sprints/{sprintId}": {
      "schema": "Sprint",
      "description": "Project Scrum iteration records."
    },
    "/organizations/{orgId}/projects/{projectId}/forms/{formId}": {
      "schema": "IntakeForm",
      "description": "Project intake forms for public submissions."
    },
    "/organizations/{orgId}/projects/{projectId}/rules/{ruleId}": {
      "schema": "AutomationRule",
      "description": "Project workflow automation rules."
    },
    "/organizations/{orgId}/projects/{projectId}/runs/{runId}": {
      "schema": "AutomationRun",
      "description": "Execution log records for automation runs."
    },
    "/organizations/{orgId}/activity/{activityId}": {
      "schema": "Activity",
      "description": "Organization activity feed."
    },
    "/organizations/{orgId}/invites/{inviteId}": {
      "schema": "Invite",
      "description": "Pending organization membership invitations."
    },
    "/organizations/{orgId}/webhooks/{webhookId}": {
      "schema": "Webhook",
      "description": "Outbound webhook definitions (admin-only)."
    },
    "/organizations/{orgId}/audit_log/{auditId}": {
      "schema": "AuditLog",
      "description": "Compliance audit log records (admin and owner only)."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Public user directory record for name, avatar color, and email."
    },
    "/users/{userId}/private/settings": {
      "schema": "UserPrivate",
      "description": "Private user preferences, notification settings, and dashboard widgets."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User Inbox notification records."
    },
    "/organizations/{orgId}/filters/{filterId}": {
      "schema": "SavedFilter",
      "description": "Organization and user saved query filters."
    }
  }
}
